# ------------------------------------------------------------------------------
/public/build
/public/hot
/public/storage
/storage/*.key
/storage/logs/*
/storage/*.log
/storage/framework/cache/data/*
/storage/framework/sessions/*
/storage/framework/views/*
/storage/app/public/*
/bootstrap/cache/*.php
/usn-parts/
Homestead.json
Homestead.yaml

# ------------------------------------------------------------------------------
# Local Uploaded Images & Temporary Storage
# ------------------------------------------------------------------------------
/public/images/*
/storage/app/public/images/*

# Preserve static website template images & branding assets
!/public/images/.gitkeep
!/public/images/product.jpg
!/public/images/product.webp
!/public/images/logo.png
!/public/images/logo.webp
!/public/images/JaffnaGold.webp
!/public/images/website images/
!/storage/app/public/.gitignore

