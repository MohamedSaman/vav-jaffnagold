# systemd unit for the AI image search service.
#
#   sudo cp deploy/image-search.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now image-search
#   sudo journalctl -u image-search -f
#
# Adjust User, WorkingDirectory and the venv path to match your server.

[Unit]
Description=Jaffna Gold AI Image Search (CLIP + FAISS)
Documentation=file:///var/www/jaffnagoldpos/ai-image-search/README.md
After=network-online.target mysql.service
Wants=network-online.target

[Service]
Type=exec
User=www-data
Group=www-data
WorkingDirectory=/var/www/jaffnagoldpos/ai-image-search

Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/var/www/jaffnagoldpos/ai-image-search/.env

# One worker: each would load its own copy of the model and the index.
ExecStart=/var/www/jaffnagoldpos/ai-image-search/.venv/bin/uvicorn \
    app.main:app --host 127.0.0.1 --port 8001 --workers 1

Restart=always
RestartSec=5
# Loading CLIP takes ~10-30 s on first start; do not kill it as a failed start.
TimeoutStartSec=180
TimeoutStopSec=30

# --- Hardening: this process parses untrusted customer uploads --------------
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
# Only these paths are writable: the index/metadata and the model cache.
ReadWritePaths=/var/www/jaffnagoldpos/ai-image-search/storage
ReadWritePaths=/var/www/jaffnagoldpos/ai-image-search/models

MemoryMax=3G
LimitNOFILE=8192

StandardOutput=journal
StandardError=journal
SyslogIdentifier=image-search

[Install]
WantedBy=multi-user.target
