# ============================================================================
# AI Image Search Service — copy to .env and adjust
#   cp .env.example .env
# ============================================================================

# ---------------------------------------------------------------- service
APP_NAME="Jaffna Gold AI Image Search"
APP_ENV=production
LOG_LEVEL=INFO
# true = one JSON object per log line (for Loki/CloudWatch/etc.)
LOG_JSON=false

# Bind to 127.0.0.1 so only the Laravel app on the same host can reach it.
# Use 0.0.0.0 only behind a firewall or reverse proxy.
HOST=127.0.0.1
PORT=8001

# Disable the interactive docs in production if the port is reachable from outside.
DOCS_ENABLED=true

# Comma-separated. Leave empty unless a browser calls this service directly
# (it should not — Laravel proxies every request).
CORS_ORIGINS=

# ---------------------------------------------------------------- security
# Shared secret for the /api/v1/index/* routes. Must match IMAGE_SEARCH_API_KEY
# in the Laravel .env. Generate one with: openssl rand -hex 32
API_KEY=
REQUIRE_API_KEY=true

# ---------------------------------------------------------------- CLIP model
CLIP_MODEL_NAME=openai/clip-vit-base-patch32
# auto | cpu | cuda | mps
DEVICE=auto
EMBEDDING_DIM=512
# 0 = PyTorch default. On a shared box, cap this to leave CPU for PHP-FPM.
TORCH_THREADS=0
EMBED_BATCH_SIZE=16
# Where the model weights are cached (~600 MB). Must be writable and persistent.
HF_HOME=
# Run a dummy inference at startup so the first customer request is not the slow one.
WARMUP_ON_START=true

# ---------------------------------------------------------------- storage
DATA_DIR=storage
INDEX_FILENAME=products.faiss
METADATA_FILENAME=metadata.sqlite

# flat = exact brute force, ~15 ms at 100k vectors. Keep this unless the
# catalogue grows past a few hundred thousand products, then switch to ivf.
INDEX_TYPE=flat
IVF_NLIST=256
IVF_NPROBE=16

# Persist the index after each mutation. Turn off only for bulk imports where
# you will call POST /api/v1/index/save yourself.
AUTOSAVE=true

# ---------------------------------------------------------------- search
DEFAULT_TOP_K=20
MAX_TOP_K=100
# Over-fetch factor before category re-ranking: 20 x 10 = 200 candidates.
CANDIDATE_MULTIPLIER=10
MAX_CANDIDATES=500

# Cosine similarity floor. Below ~0.55 results stop looking related to the query.
# Raise towards 0.70 for stricter matching, lower to 0.45 to always show something.
MIN_SIMILARITY=0.55

# boost     = same-type products get a score bonus (recommended)
# partition = same-type products listed first, then the rest
# strict    = drop other types entirely, unless too few results remain
SEARCH_STRATEGY=boost
CATEGORY_BOOST=0.08
JEWELRY_TYPE_BOOST=0.05
# Ignore the detected type below this confidence rather than mis-ranking on it.
TYPE_CONFIDENCE_THRESHOLD=0.28
STRICT_MIN_RESULTS=5

# ---------------------------------------------------------------- uploads
# 5 MB, matching the Laravel validation rule.
MAX_UPLOAD_BYTES=5242880
ALLOWED_IMAGE_FORMATS=JPEG,PNG,WEBP,GIF,BMP
MAX_IMAGE_PIXELS=40000000
MIN_IMAGE_SIDE=32

# ------------------------------------------------------- product image access
# Absolute paths to the Laravel installation, so the indexer can read product
# images straight off disk instead of over HTTP.
LARAVEL_PUBLIC_PATH=/home/sam/Documents/Systems/jaffnagoldpos/public
LARAVEL_STORAGE_PATH=/home/sam/Documents/Systems/jaffnagoldpos/storage

# Allow fetching images by URL (needed if images live on a CDN or S3).
ALLOW_REMOTE_IMAGES=true
IMAGE_FETCH_TIMEOUT=10.0
DEFAULT_IMAGE_NAMES=images/product.jpg,images/products/product.jpg

# ---------------------------------------------------------------- MySQL
# Same database as the Laravel app. A read-only MySQL user is sufficient.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=jaffnagold
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Only index products with website_live = 1 (what the storefront actually shows).
INDEX_WEBSITE_LIVE_ONLY=true
REBUILD_CHUNK_SIZE=200
